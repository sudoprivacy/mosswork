# mosswork standalone deployment
#
# Copy this directory for another environment, then change at least:
#   MOSSWORK_PROJECT_NAME, MOSSWORK_PORT, MOSSWORK_DATA
# The application image must already be present in Docker. The compose file
# deliberately does not build or pull images, so startup works offline.

MOSSWORK_PROJECT_NAME=mosswork
MOSSWORK_IMAGE=mosswork:latest
MOSSWORK_PORT=8088
MOSSWORK_DATA=./data
MOSSWORK_LOG_LEVEL=info

# Leave empty to let the container generate a random first-login password in
# data/credential.txt. Set a strong value if you want a known password.
MOSSWORK_DEFAULT_PASSWORD=
MOSSWORK_ADMIN_USERNAME=admin
MOSSWORK_ADMIN_DISPLAY_NAME=Admin

# Optional database and provider settings.
MOSSWORK_DATABASE_URL=
MOSSWORK_DATABASE_DRIVER=
MOSSWORK_DATABASE_SQLITE_PATH=
MOSSWORK_DATABASE_HOST=
MOSSWORK_DATABASE_PORT=
MOSSWORK_DATABASE_NAME=
MOSSWORK_DATABASE_USER=
MOSSWORK_DATABASE_PASSWORD=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
