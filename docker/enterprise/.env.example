# Copy the deployment directory and change project name, port and data root.
# Values use shell-compatible dotenv syntax; quote values containing spaces.
# Leave DATA_ROOT empty to create data/ inside this deployment directory.
# start.sh generates private database passwords and signing keys on first use.
MOSSWORK_RELEASE_TAG=@@MOSSWORK_RELEASE_TAG@@
MOSSWORK_PROJECT_NAME=moss-server
MOSSWORK_BIND_ADDRESS=0.0.0.0
MOSSWORK_PORT=8088
MOSSWORK_DATA_ROOT=
MOSSWORK_DOCKER_SOCKET=/var/run/docker.sock
MOSSWORK_DEFAULT_TIMEZONE=Asia/Shanghai
