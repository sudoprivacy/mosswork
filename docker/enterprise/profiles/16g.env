# Candidate budgets: three workers, three web processes, eight server tool tasks; models unlimited by default.
MOSSWORK_RESOURCE_PROFILE=16g
COMPOSE_PROFILES=three-workers
MOSSWORK_WORKER_URLS={"runtime-worker":"http://worker:8088","runtime-worker2":"http://worker2:8088","runtime-worker3":"http://worker3:8088"}
MOSSWORK_WEB3_UPSTREAM=server web3:8088;
MOSSWORK_PG_MEMORY=1536m
MOSSWORK_IM_MEMORY=512m
MOSSWORK_WEB_MEMORY=384m
MOSSWORK_WORKER_MEMORY=2048m
MOSSWORK_SANDBOX_MEMORY=512m
MOSSWORK_SANDBOX_TOTAL_MEMORY=4096m
MOSSWORK_WEB_POOL_MAX=4
MOSSWORK_WORKER_POOL_MAX=8
MOSSWORK_IM_POOL_MAX_CONNS=16
