# Candidate budgets: two workers, two web processes, four server tool tasks; models unlimited by default.
MOSSWORK_RESOURCE_PROFILE=8g
COMPOSE_PROFILES=two-workers
MOSSWORK_WORKER_URLS={"runtime-worker":"http://worker:8088","runtime-worker2":"http://worker2:8088"}
MOSSWORK_WEB3_UPSTREAM=
MOSSWORK_PG_MEMORY=768m
MOSSWORK_IM_MEMORY=384m
MOSSWORK_WEB_MEMORY=320m
MOSSWORK_WORKER_MEMORY=1280m
MOSSWORK_SANDBOX_MEMORY=384m
MOSSWORK_SANDBOX_TOTAL_MEMORY=1536m
MOSSWORK_WEB_POOL_MAX=3
MOSSWORK_WORKER_POOL_MAX=6
MOSSWORK_IM_POOL_MAX_CONNS=12
