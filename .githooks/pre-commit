#!/usr/bin/env bash
# Independent documentation/tool changes use checked scoped validation.
# Application and unknown changes retain make precommit + dashboard build.
# Enable once per clone:  make install-hooks
# Bypass (emergency only): SKIP_PRECOMMIT=1 git commit ...
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Keep a foreign caller virtualenv from changing PATH before frozen validation.
# Explicit uv interpreter/environment choices retain their original launch route.
dispatcher=(uv run --no-project python)
dispatcher_bin=""
if [[ -z "${UV_PROJECT_ENVIRONMENT:-}" && -z "${UV_PYTHON:-}" ]]; then
  if [[ -x "$ROOT/.venv/Scripts/python.exe" ]]; then
    dispatcher_bin="$ROOT/.venv/Scripts"
    dispatcher=("$dispatcher_bin/python.exe")
  elif [[ -x "$ROOT/.venv/bin/python" ]]; then
    dispatcher_bin="$ROOT/.venv/bin"
    dispatcher=("$dispatcher_bin/python")
  fi
fi
echo "[pre-commit] Dispatcher: ${dispatcher[*]}"
# Match uv's project-interpreter PATH in this child only. The later full gate
# must inherit its original caller PATH after the dispatcher returns exit 3.
if (
  if [[ -n "$dispatcher_bin" ]]; then
    dispatcher_path="$(cd "$dispatcher_bin" && pwd)"
    export PATH="$dispatcher_path:$PATH"
  fi
  "${dispatcher[@]}" tools/precommit.py
); then
  exit 0
else
  scoped_status=$?
  if [[ "$scoped_status" != "3" ]]; then
    exit "$scoped_status"
  fi
fi

# Remember staged paths so we can re-add them after auto-format rewrites the worktree.
# Portable (bash 3.2+): avoid `mapfile` (bash 4+ only).
STAGED_FILES=()
while IFS= read -r -d '' line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

run_validation() {
  # Git fixture repositories must not inherit the parent commit's index.
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX "$@"
}

echo "[pre-commit] make precommit  (format checks + lint + typecheck + testmon-scoped test)"
run_validation make precommit

# If format rewrote files that were already staged, refresh the index so the
# commit includes the formatted content (worktree vs index drift).
if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    printf '%s\0' "${existing[@]}" | git --literal-pathspecs add --pathspec-from-file=- --pathspec-file-nul
  fi
fi

echo "[pre-commit] dashboard npm run build"
(
  cd "$ROOT/dashboard"
  run_validation npm run build
)

echo "[pre-commit] all checks passed"
