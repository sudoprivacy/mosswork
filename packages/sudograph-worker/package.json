{
  "name": "@sudo/sudograph-worker",
  "version": "0.0.5",
  "private": true,
  "description": "Host-bound portable Sudograph compiler MCP and review worker",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudoprivacy/mosswork.git",
    "directory": "packages/sudograph-worker"
  },
  "engines": {
